
# --- Python 缓存 / 字节码 ---
__pycache__/
*.py[cod]
*$py.class

# --- 构建 / 安装 / 日志 ---
build/
install/
log/

# --- 环境变量 ---
.venv/
venv/
env/
ENV/

# --- 测试 / 覆盖率 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE / 编辑器 ---
.vscode/
.idea/
*.swp
*~

# --- 数据 / 临时产物 ---
*.tmp
*/tmp/*
*.bak
*.npy
pick_garbage/

# --- 媒体资源默认不追踪（体积大），但放行文档里的演示图/GIF ---
*.jpg
*.jpeg
*.png
!docs/assets/**
!projects/*/assets/**

# --- Python 打包产物 / 本地配置 ---
dist/
*.egg-info/
.eggs/
.env
.env.*
*.local
.DS_Store

