<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>greeting_body</name>
  <version>0.0.0</version>
  <description>酒店迎宾机器人实机礼仪动作库：PlayMotion 服务端，流式下发头/臂/腰关节帧</description>
  <maintainer email="3059342114@qq.com">moke</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>greeting_interfaces</depend>
  <depend>ros2_bridge_msgs</depend>
  <depend>std_msgs</depend>
  <!-- 待机扫视的「H 右档暂停」门控需要 /sbus_data/event（bodyctrl_msgs/SbusData） -->
  <depend>bodyctrl_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
