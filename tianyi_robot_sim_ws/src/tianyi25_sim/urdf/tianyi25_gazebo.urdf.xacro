<?xml version="1.0"?>
<!--天轶 2.5 Gazebo 物理仿真描述。-->
<robot name="tianyi25_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 当前生效的扫掠/整定档：由 gazebo.launch.py 的 sweep_config 传进来（只写文件名），
       默认 gz_joint_sweep.yaml。每一档都【自包含】joints + arm_control + posture_lock
       三段，所以 xacro / launch / 扫掠节点读的是同一份文件，换档即整体切换。 -->
  <xacro:arg name="sweep_config" default="gz_joint_sweep.yaml"/>
  <xacro:property name="sweep_config_file" value="$(arg sweep_config)"/>
  <xacro:property name="cfg"
                  value="${xacro.load_yaml('$(find tianyi25_sim)/config/' + sweep_config_file)}"/>
  <!-- 纯运动学/动力学模型（含 inertial / collision / limit） -->
  <xacro:include filename="$(find tianyi25_urdf)/urdf/tianyi25_urdf.urdf"/>
  <xacro:property name="wheel_radius"      value="0.072"/>
  <xacro:property name="wheel_width"       value="0.08"/>
  <xacro:property name="wheel_separation"  value="0.44"/>   <!-- 左右轮心平面距 = 2×0.22 -->
  <xacro:property name="axle_z"            value="0.06"/>   <!-- 轮轴在 base 中的高度 -->
  <xacro:property name="rear_axle_x"       value="-0.20"/>
  <xacro:property name="front_axle_x"      value="0.30"/>
  <xacro:property name="wheel_y"           value="0.22"/>

  <xacro:property name="lidar_x"           value="0.20"/>
  <xacro:property name="lidar_z"           value="0.415"/>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="drive_wheel" params="prefix cx cy">
    <link name="${prefix}_wheel_link">
      <xacro:cylinder_inertia m="0.6" r="${wheel_radius}" l="${wheel_width}"/>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <!-- 摩擦不写在 <collision><surface> 里：Jazzy 的 URDF→SDF 转换器【不认】URDF 的
         <surface> 块，会把 <friction><ode><mu> 整个丢掉。必须用 gz 的 <mu1>/<mu2>
         扩展，它们会被正确写进 SDF 的 <surface><friction><ode>。 -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="${cx} ${cy} ${axle_z}" rpy="0 0 0"/>
      <parent link="base"/>
      <child link="${prefix}_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- 前左/前右/后左/后右（y+ = left，与本体命名一致） -->
  <xacro:drive_wheel prefix="front_l" cx="${front_axle_x}" cy="${wheel_y}"/>
  <xacro:drive_wheel prefix="front_r" cx="${front_axle_x}" cy="${-wheel_y}"/>
  <xacro:drive_wheel prefix="rear_l"  cx="${rear_axle_x}"  cy="${wheel_y}"/>
  <xacro:drive_wheel prefix="rear_r"  cx="${rear_axle_x}"  cy="${-wheel_y}"/>

  <!-- base 链接整体零摩擦：网格里焊死的四个轮形以及任何 base 碰撞擦地时都不产生
       拖拽（抓地只靠上面 4 个真实轮链接）。用 gz <mu1>/<mu2> 扩展，作用于 base
       的全部 collision。 -->
  <gazebo reference="base">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- [2D 雷达] 前向 270°，直接安装在本体 base 的前甲板上
       雷达自身高度 0.05，中心 z=0.22+0.025=0.245 与 base 上表面齐平。 -->
  <link name="lidar_link">
    <xacro:cylinder_inertia m="0.1" r="0.035" l="0.05"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="lidar_black"><color rgba="0.1 0.1 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="${lidar_x} 0 0.245" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="lidar_link"/>
  </joint>

  <!-- ==========================================================
       上半身关节驱动：位置环整定。
       所有数值来自 config/<sweep_config> 的 arm_control / posture_lock 段
       （默认 gz_joint_sweep.yaml，可用 sweep_config 切换到 wave_greet.yaml 等档），
       不在这里重复写死——那份 yaml 是当前档的唯一真源。

       JointTrajectoryController 按元素【出现顺序】解析配置：<joint_name> 之后
       紧跟该关节的 <initial_position> 与 PID 参数，因此必须逐关节交错展开——
       若把 21 个 <joint_name> 连在一起、参数另放，解析会错位且增益取不到值，
       表现为"收到轨迹但关节不出力"。（这条已被实测证实，保留。）

       关于 position_cmd_min/max：语义是关节【力矩】饱和值 (Nm)，不是角速度。
       实测：设为 1.5 时只有 effort ≤ 24 的关节能跟随轨迹；设为 20 时 20/21 恢复。
       因此逐关节按 <limit effort> × torque_ratio 取值，轻载关节不会被过驱。
       ========================================================== -->
  <xacro:property name="arm" value="${cfg['arm_control']}"/>
  <xacro:property name="posture_lock" value="${cfg['posture_lock']}"/>
  <xacro:property name="torque_map" value="${arm['torque_limits_nm']}"/>

  <xacro:macro name="joint_cfg_list" params="js">
    <xacro:if value="${len(js) > 0}">
      <joint_name>${js[0]}</joint_name>
      <initial_position>0</initial_position>
      <position_p_gain>${arm['position_p_gain']}</position_p_gain>
      <position_i_gain>${arm['position_i_gain']}</position_i_gain>
      <position_d_gain>${arm['position_d_gain']}</position_d_gain>
      <position_i_min>${arm['position_i_min']}</position_i_min>
      <position_i_max>${arm['position_i_max']}</position_i_max>
      <position_cmd_min>${-arm['torque_ratio'] * torque_map.get(js[0], arm['torque_default_nm'])}</position_cmd_min>
      <position_cmd_max>${arm['torque_ratio'] * torque_map.get(js[0], arm['torque_default_nm'])}</position_cmd_max>
      <xacro:joint_cfg_list js="${js[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <gazebo>
    <plugin filename="gz-sim-joint-trajectory-controller-system"
            name="gz::sim::systems::JointTrajectoryController">
      <xacro:joint_cfg_list js="${list(cfg['joints'].keys())}"/>
    </plugin>
  </gazebo>

  <!-- ==========================================================
       姿态锁止弹簧（腿柱两节 + 腰俯仰）。
       first/second_leg_pitch 与 waist_pitch 在 0 位都是倒立摆的不稳定平衡点：
       躯干压在关节上方，重力力矩按 K_g·sinθ 随偏角增长。位置环的比例增益只有
       position_p_gain = 200 Nm/rad，一旦 K_g 逼近它，θ=0 就不再是唯一解
       （200·θ = K_g·sinθ 在 0 之外还有第二个根），躯干会自己漂过去。
       实测反推 K_g：腿柱 ≈ 603、腰 ≈ 202 Nm/rad；实测旧配置下腿柱前倾 9.8°、
       腰前倾 15.1°，合计 24.9° —— 就是"打招呼时在弯腰"。
       加扭转弹簧后，只要 (K + 200) > K_g，方程就只剩 θ=0 一个解 → 0 位唯一稳定。
       刚度取值与推导见 config/gz_joint_sweep.yaml 的 posture_lock 段。
       这几节在 motions.yaml / 扫掠配置里都恒为 0，不参与动作。

       阻尼不加在这里：URDF 的 <damping> 会被 Jazzy 的 URDF→SDF 转换器丢弃
       （实测告警 "XML Element[damping], child of element[joint], not defined in SDF"），
       摆动衰减由位置环的 position_d_gain 承担。
       ========================================================== -->
  <xacro:macro name="joint_springs" params="names">
    <xacro:if value="${len(names) > 0}">
      <gazebo reference="${names[0]}">
        <implicitSpringDamper>1</implicitSpringDamper>
        <springStiffness>${posture_lock[names[0]]}</springStiffness>
        <springReference>0</springReference>
      </gazebo>
      <xacro:joint_springs names="${names[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:joint_springs names="${list(posture_lock.keys())}"/>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ==========================================================
       四轮驱动 + 里程计（skid-steer）。
       每侧列出两个轮关节：插件接受同侧多个 <left_joint>/<right_joint>，
       按轮速平均换算里程计。skid 转向时四轮横向滑擦，需要足够的角加速度余量，
       故角速度上限取 0.8、角加速度 0.8。
       cmd_vel 话题固定为 /model/<模型名>/cmd_vel（插件无 topic 参数），
       由 gazebo.launch.py 用 ROS 侧 remapping 把它变成 /cmd_vel。
       tf_topic 保留默认但不桥接：odom→base_footprint 由 gz_odom_tf 节点
       从 /odom 发布，这样 frame 名完全可控（gz 侧 TF 会带模型作用域前缀）。
       ========================================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>front_l_wheel_joint</left_joint>
      <left_joint>rear_l_wheel_joint</left_joint>
      <right_joint>front_r_wheel_joint</right_joint>
      <right_joint>rear_r_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <!-- 绝对话题名：不加作用域前缀，便于 ros_gz_bridge 直接对名 -->
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.4</max_linear_velocity>
      <min_linear_velocity>-0.4</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>0.8</max_angular_acceleration>
      <min_angular_acceleration>-0.8</min_angular_acceleration>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <!-- gz_frame_id 让消息里的 frame_id 直接是 lidar_link，
           与 robot_state_publisher 发布的 TF 对上（否则 gz 会填带模型作用域的名字） -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>540</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619449</min_angle>
            <max_angle>2.35619449</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.30</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <alwaysOn>true</alwaysOn>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- 注意：不要在 URDF 里用 <parent link="world"> 固定关节来"站住"整机。
       实测（gz-sim 8.15）该写法会让模型被判为不可动，内部关节既不被控制器驱动、
       也不受重力下垂，等于废掉物理仿真。整机站立由本体 base 下的四轮承担。 -->
</robot>
